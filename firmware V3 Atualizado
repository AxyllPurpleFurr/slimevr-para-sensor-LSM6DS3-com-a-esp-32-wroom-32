// --------------- Mahony AHRS --------------
class MahonyAHRS {
public:
    MahonyAHRS(float kp = MAHONY_KP, float ki = MAHONY_KI) : twoKp(2.0f * kp), twoKi(2.0f * ki),
        q0(1.0f), q1(0.0f), q2(0.0f), q3(0.0f), integralFBx(0), integralFBy(0), integralFBz(0) {}

    void update(float gx, float gy, float gz, float ax, float ay, float az, float dt) {
        float recipNorm;
        float vx, vy, vz;
        float ex, ey, ez;
        float qa, qb, qc;

        recipNorm = invSqrt(ax * ax + ay * ay + az * az);
        if (recipNorm <= 0.0f) return;
        ax *= recipNorm; ay *= recipNorm; az *= recipNorm;

        vx = 2.0f * (q1 * q3 - q0 * q2);
        vy = 2.0f * (q0 * q1 + q2 * q3);
        vz = q0 * q0 - q1 * q1 - q2 * q2 + q3 * q3;

        ex = (ay * vz - az * vy);
        ey = (az * vx - ax * vz);
        ez = (ax * vy - ay * vx);

        if (twoKi > 0.0f) {
            integralFBx += twoKi * ex * dt;
            integralFBy += twoKi * ey * dt;
            integralFBz += twoKi * ez * dt;
            gx += integralFBx; gy += integralFBy; gz += integralFBz;
        } else {
            integralFBx = integralFBy = integralFBz = 0.0f;
        }

        gx += twoKp * ex;
        gy += twoKp * ey;
        gz += twoKp * ez;

        gx *= 0.5f * dt;
        gy *= 0.5f * dt;
        gz *= 0.5f * dt;

        qa = q0; qb = q1; qc = q2;
        q0 += (-qb * gx - qc * gy - q3 * gz);
        q1 += (qa * gx + qc * gz - q3 * gy);
        q2 += (qa * gy - qb * gz + q3 * gx);
        q3 += (qa * gz + qb * gy - qc * gx);

        recipNorm = invSqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3);
        q0 *= recipNorm; q1 *= recipNorm; q2 *= recipNorm; q3 *= recipNorm;
    }

    void getQuaternion(float *out_q0, float *out_q1, float *out_q2, float *out_q3) {
        *out_q0 = q0; *out_q1 = q1; *out_q2 = q2; *out_q3 = q3;
    }

    void resetOrientation() {
        q0 = 1.0f; q1 = q2 = q3 = 0.0f;
        integralFBx = integralFBy = integralFBz = 0.0f;
    }

private:
    float twoKp, twoKi;
    float q0, q1, q2, q3;
    float integralFBx, integralFBy, integralFBz;
    inline float invSqrt(float x) { return (x <= 0.0f) ? 0.0f : 1.0f / sqrtf(x); }
};

MahonyAHRS mahony(MAHONY_KP, MAHONY_KI);

// ------------- Helpers de protocolo (BIG-ENDIAN = ordem de rede, como o SlimeVR exige) -------------
void writeUint32BE(uint8_t *buf, uint32_t val) {
    buf[0] = (val >> 24) & 0xFF;
    buf[1] = (val >> 16) & 0xFF;
    buf[2] = (val >> 8) & 0xFF;
    buf[3] = (val >> 0) & 0xFF;
}

void writeUint64BE(uint8_t *buf, uint64_t val) {
    for (int i = 0; i < 8; i++) buf[i] = (val >> ((7 - i) * 8)) & 0xFF;
}

void writeFloatBE(uint8_t *buf, float v) {
    uint32_t u;
    memcpy(&u, &v, 4);
    writeUint32BE(buf, u);
}

const uint8_t PACKET_HEARTBEAT = 0;
const uint8_t PACKET_HANDSHAKE = 3;
const uint8_t PACKET_PING_PONG = 10;
const uint8_t PACKET_SENSOR_INFO = 15;
const uint8_t PACKET_ROTATION_DATA = 17;

#define MAX_PKT 512
uint8_t pktbuf[MAX_PKT];
int pktpos = 0;

void pktBegin() { pktpos = 0; }
void pktWriteByte(uint8_t b) { if (pktpos < MAX_PKT) pktbuf[pktpos++] = b; }
void pktWriteInt(uint32_t i) { if (pktpos + 4 <= MAX_PKT) { writeUint32BE(pktbuf + pktpos, i); pktpos += 4; } }
void pktWriteLong(uint64_t l) { if (pktpos + 8 <= MAX_PKT) { writeUint64BE(pktbuf + pktpos, l); pktpos += 8; } }
void pktWriteFloat(float f) { if (pktpos + 4 <= MAX_PKT) { writeFloatBE(pktbuf + pktpos, f); pktpos += 4; } }
void pktWriteBytes(const uint8_t *b, size_t n) { if (pktpos + (int)n <= MAX_PKT) { memcpy(pktbuf + pktpos, b, n); pktpos += n; } }
void pktWritePacketType(uint8_t type) { pktWriteInt((uint32_t)type); }   // tipo = int de 4 bytes (big-endian)

bool isZeroIp(const IPAddress &ip) { return ip[0] == 0 && ip[1] == 0 && ip[2] == 0 && ip[3] == 0; }

void pktEndAndSend(IPAddress serverIp) {
    IPAddress dest = isZeroIp(serverIp) ? IPAddress(255, 255, 255, 255) : serverIp;
    udp.beginPacket(dest, SLIME_PORT);
    udp.write(pktbuf, pktpos);
    udp.endPacket();
}

void sendHandshake(IPAddress serverIp) {
    pktBegin();
    pktWritePacketType(PACKET_HANDSHAKE);
    pktWriteLong((uint64_t)0);
    pktWriteInt(BOARD_TYPE);
    pktWriteInt(IMU_TYPE);
    pktWriteInt(MCU_TYPE);
    pktWriteInt(0); pktWriteInt(0); pktWriteInt(0);
    pktWriteInt(FW_BUILD);

    const char *fw = "esp32-lsm6ds3-perfect-0.3";
    uint8_t flen = (uint8_t)strlen(fw);
    pktWriteByte(flen);
    pktWriteBytes((const uint8_t*)fw, flen);

    uint8_t mac[6];
    WiFi.macAddress(mac);
    mac[5] = TRACKER_ID;
    pktWriteBytes(mac, 6);

    pktEndAndSend(serverIp);
#if DEBUG_SERIAL
    Serial.println("Handshake sent.");
#endif
}

// A resposta do servidor é: 1 byte (3) + texto "Hey OVR =D 5"
bool isHandshakeResponse(const uint8_t *buf, int len) {
    const char pattern[] = "Hey OVR =D 5";
    int plen = (int)strlen(pattern);
    return len >= 1 + plen && buf[0] == PACKET_HANDSHAKE && memcmp(buf + 1, pattern, plen) == 0;
}

bool waitForHandshakeResponse(uint32_t timeout_ms = 5000) {
    uint32_t start = millis();
    while (millis() - start < timeout_ms) {
        int p = udp.parsePacket();
        if (p > 0) {
            int len = udp.read(pktbuf, sizeof(pktbuf));
            if (len > 0 && isHandshakeResponse(pktbuf, len)) {
                SERVER_IP = udp.remoteIP();
                slimeConnected = true;
                lastServerPacketMillis = millis();
#if DEBUG_SERIAL
                Serial.print("SlimeVR server found at: ");
                Serial.println(SERVER_IP);
#endif
                return true;
            }
        }
        delay(5);
    }
    return false;
}

void sendSensorInfo(IPAddress serverIp) {
    pktBegin();
    pktWritePacketType(PACKET_SENSOR_INFO);
    pktWriteLong(packetNumber++);
    pktWriteByte(0);                 // sensor id
    pktWriteByte(1);                 // status: OK
    pktWriteByte((uint8_t)IMU_TYPE); // tipo do sensor
    pktEndAndSend(serverIp);
#if DEBUG_SERIAL
    Serial.println("Sensor info (sensor 0) sent.");
#endif
}

void sendHeartbeatToServer(IPAddress serverIp) {
    if (!slimeConnected) return;
    pktBegin();
    pktWritePacketType(PACKET_HEARTBEAT);
    pktWriteLong(packetNumber++);
    pktEndAndSend(serverIp);
}

void sendRotationQuatToServer(IPAddress serverIp, float x, float y, float z, float w) {
    if (!slimeConnected) return;
    pktBegin();
    pktWritePacketType(PACKET_ROTATION_DATA);
    pktWriteLong(packetNumber++);
    pktWriteByte(0);                 // sensor id
    pktWriteByte(1);                 // tipo de dado: rotação normal
    pktWriteFloat(x); pktWriteFloat(y); pktWriteFloat(z); pktWriteFloat(w);
    pktWriteByte(0);                 // precisão da calibração
    pktEndAndSend(serverIp);
}

// ------------- IMU init / calibração -------------
void initIMU() {
    Wire.begin(I2C_SDA, I2C_SCL);
    // 400 kHz reduz o tempo bloqueado no I2C (se tiver erro de leitura com fios longos, volte para 100000)
    Wire.setClock(400000);
#if DEBUG_SERIAL
    Serial.println("Initializing LSM6DS3...");
#endif

    // Valores válidos de taxa no LSM6DS3: 13, 26, 52, 104, 208, 416, 833, 1666 Hz
    imu.settings.gyroEnabled = 1;
    imu.settings.gyroRange = 1000;
    imu.settings.gyroSampleRate = 208;
    imu.settings.gyroBandWidth = 100;
    imu.settings.accelEnabled = 1;
    imu.settings.accelRange = 4;
    imu.settings.accelSampleRate = 208;
    imu.settings.accelBandWidth = 100;

    if (imu.begin() != 0) {
        Serial.println("ERROR: Could not initialize LSM6DS3. Restarting...");
        delay(1000);
        ESP.restart();
    }
#if DEBUG_SERIAL
    Serial.println("LSM6DS3 OK.");
#endif
}

// Mede o bias do giroscópio e valida pelo desvio padrão (sensor realmente parado)
bool measureGyroBias(int samples, int delayMs, float maxStdDps, float &bx, float &by, float &bz) {
    double sx = 0, sy = 0, sz = 0;
    double sxx = 0, syy = 0, szz = 0;

    for (int i = 0; i < samples; i++) {
        double x = imu.readFloatGyroX();
        double y = imu.readFloatGyroY();
        double z = imu.readFloatGyroZ();
        sx += x; sy += y; sz += z;
        sxx += x * x; syy += y * y; szz += z * z;
        delay(delayMs);

        // Mantém o servidor vendo o tracker vivo durante a recalibração
        if (slimeConnected && (i % 40) == 39) sendHeartbeatToServer(SERVER_IP);
    }

    double n = (double)samples;
    double mx = sx / n, my = sy / n, mz = sz / n;
    double vx = sxx / n - mx * mx;
    double vy = syy / n - my * my;
    double vz = szz / n - mz * mz;
    if (vx < 0) vx = 0;
    if (vy < 0) vy = 0;
    if (vz < 0) vz = 0;

    float stdX = sqrtf((float)vx), stdY = sqrtf((float)vy), stdZ = sqrtf((float)vz);
    float stdMax = stdX;
    if (stdY > stdMax) stdMax = stdY;
    if (stdZ > stdMax) stdMax = stdZ;

    bx = (float)mx; by = (float)my; bz = (float)mz;
#if DEBUG_SERIAL
    Serial.printf("  bias measured -> X: %.4f Y: %.4f Z: %.4f | max std: %.4f dps\n", bx, by, bz, stdMax);
#endif
    return stdMax <= maxStdDps;
}

void calibrateIMU() {
    Serial.println("Gyro calibration: keep the tracker STILL...");
    delay(3000);

    float bx = 0, by = 0, bz = 0;
    bool ok = false;

    for (int attempt = 1; attempt <= BOOT_CAL_MAX_ATTEMPTS; attempt++) {
        Serial.printf("Calibration attempt %d/%d\n", attempt, BOOT_CAL_MAX_ATTEMPTS);
        ok = measureGyroBias(BOOT_CAL_SAMPLES, BOOT_CAL_DELAY_MS, CAL_MAX_STD_DPS, bx, by, bz);
        if (ok) break;
        Serial.println("  Sensor moved during calibration, retrying...");
        delay(500);
    }

    gyroBiasX = bx; gyroBiasY = by; gyroBiasZ = bz;
    restCounter = 0;

    if (ok) Serial.println("Gyro calibration done (valid).");
    else    Serial.println("WARNING: calibration finished without perfect still sensor. Press 'r' or reset when still.");
    Serial.printf("Bias -> X: %.6f  Y: %.6f  Z: %.6f\n", gyroBiasX, gyroBiasY, gyroBiasZ);

    imuOffsets.ax = 0; imuOffsets.ay = 0; imuOffsets.az = 0;
}

// Recalibração rápida no reset: só atualiza o bias se o sensor estiver parado
void quickRecalibrateGyroBias() {
    Serial.println("Quick recalibrate gyro bias (reset)...");
    float bx, by, bz;
    bool still = measureGyroBias(QUICK_RECAL_SAMPLES, BOOT_CAL_DELAY_MS, CAL_MAX_STD_DPS, bx, by, bz);
    if (still) {
        gyroBiasX = bx; gyroBiasY = by; gyroBiasZ = bz;
        restCounter = 0;
        Serial.printf("New bias: %.6f %.6f %.6f\n", gyroBiasX, gyroBiasY, gyroBiasZ);
    } else {
        Serial.println("Sensor in motion: previous bias maintained.");
    }
}

// ------------- WiFi -------------
void connectWiFi() {
    Serial.println("Starting WiFiManager...");
    WiFiManager wm;
    const char* ap_name = "SlimeVR Tracker Setup";
    if (!wm.autoConnect(ap_name)) {
        Serial.println("WiFiManager failed - restarting...");
        delay(2000);
        ESP.restart();
    }

    // Sem modem sleep: elimina travadas e perda de pacotes por economia de energia do Wi-Fi
    WiFi.setSleep(false);
    WiFi.setAutoReconnect(true);

    Serial.print("Connected. IP: ");
    Serial.println(WiFi.localIP());
}

// ------------- Helpers -------------
#ifndef DEG_TO_RAD
#define DEG_TO_RAD 0.01745329251994329576923690768489f
#endif
#ifndef RAD_TO_DEG
#define RAD_TO_DEG 57.295779513082320876f
#endif
const float G_TO_MS2 = 9.80665f;

static inline float clampf(float v, float a, float b) {
    if (v < a) return a;
    if (v > b) return b;
    return v;
}

float readVin() {
    int raw = analogRead(VIN_ADC_PIN);
    float v = ((float)raw / 4095.0f) * ADC_REF;
    return v * VIN_SCALE;
}

// ------------- UDP recebido (handshake, ping, reset) -------------
#if DEBUG_SERIAL
void debugPrintUdpPacket(const uint8_t *buf, int len, IPAddress remote, uint16_t remotePort) {
    Serial.printf("[NET] recv pkt from %s:%u len=%d\n", remote.toString().c_str(), remotePort, len);
    Serial.print("ASCII preview: ");
    for (int i = 0; i < len; ++i) {
        char c = (char)buf[i];
        if (c >= 32 && c <= 126) Serial.print(c);
        else Serial.print('.');
    }
    Serial.println();
}
#endif

void handleIncomingUdp() {
    // Lê no máximo alguns pacotes por volta para nunca atrasar o envio dos dados
    for (int n = 0; n < 4; n++) {
        int p = udp.parsePacket();
        if (p <= 0) return;

        IPAddress remote = udp.remoteIP();
        uint16_t remotePort = udp.remotePort();
        int len = udp.read(pktbuf, sizeof(pktbuf) - 1);
        if (len <= 0) continue;
        pktbuf[len] = 0;
#if DEBUG_SERIAL
        debugPrintUdpPacket(pktbuf, len, remote, remotePort);
#endif

        // 1) Resposta de handshake (também vale para reconexão)
        if (isHandshakeResponse(pktbuf, len)) {
            SERVER_IP = remote;
            slimeConnected = true;
            lastServerPacketMillis = millis();
            sendSensorInfo(SERVER_IP);
            continue;
        }

        // Daqui para frente só aceita pacotes do servidor já conhecido
        if (!slimeConnected || !(remote == SERVER_IP)) continue;
        lastServerPacketMillis = millis();

        // 2) PING do servidor: precisa devolver o mesmo pacote (PONG)
        if (len >= 8 && pktbuf[0] == 0 && pktbuf[1] == 0 && pktbuf[2] == 0 && pktbuf[3] == PACKET_PING_PONG) {
            udp.beginPacket(remote, remotePort);
            udp.write(pktbuf, len);
            udp.endPacket();
            continue;
        }

        // 3) Comando de reset em texto
        String payload = String((char*)pktbuf);
        payload.toUpperCase();
        if (payload.indexOf("SLIMEVR_RESET") >= 0 || payload.indexOf("RESET_ORIENTATION") >= 0 || payload.indexOf("RESET") >= 0) {
            Serial.println("Reset orientation requested (UDP). Performing reset...");
            mahony.resetOrientation();
            quickRecalibrateGyroBias();
            sendSensorInfo(SERVER_IP);
        }
    }
}

// Reenvia handshake se o servidor ficar em silêncio (reiniciou, trocou de IP, esqueceu o tracker)
void checkServerLink() {
    unsigned long now = millis();
    unsigned long silence = now - lastServerPacketMillis;

    if (!serverIpFixed && slimeConnected && silence > SERVER_SILENCE_LOST_MS) {
        Serial.println("Server lost. Going back to broadcast discovery...");
        slimeConnected = false;
        SERVER_IP = IPAddress(0, 0, 0, 0);
    }

    bool needHandshake = !slimeConnected || silence > SERVER_SILENCE_REHANDSHAKE_MS;
    if (needHandshake && (now - lastHandshakeMillis) >= REHANDSHAKE_INTERVAL_MS) {
        lastHandshakeMillis = now;
        sendHandshake(SERVER_IP);   // broadcast se SERVER_IP = 0.0.0.0
    }
}

// ------------- Leitura e envio principal -------------
void readAndSendSensorData() {
    float raw_ax_g = imu.readFloatAccelX();
    float raw_ay_g = imu.readFloatAccelY();
    float raw_az_g = imu.readFloatAccelZ();

    float measured_gx = imu.readFloatGyroX();
    float measured_gy = imu.readFloatGyroY();
    float measured_gz = imu.readFloatGyroZ();

    float raw_gx_dps = measured_gx - gyroBiasX;
    float raw_gy_dps = measured_gy - gyroBiasY;
    float raw_gz_dps = measured_gz - gyroBiasZ;

    float ax_ms2 = raw_ax_g * G_TO_MS2;
    float ay_ms2 = raw_ay_g * G_TO_MS2;
    float az_ms2 = raw_az_g * G_TO_MS2;

    float gx = raw_gx_dps * DEG_TO_RAD;
    float gy = raw_gy_dps * DEG_TO_RAD;
    float gz = raw_gz_dps * DEG_TO_RAD;

    // dt: a subtração de uint32_t já é segura contra overflow do micros()
    static uint32_t lastMicrosLocal = 0;
    uint32_t nowMicros = micros();
    float dt = 1.0f / (float)IMU_UPDATE_RATE;
    if (lastMicrosLocal != 0) {
        dt = (float)(uint32_t)(nowMicros - lastMicrosLocal) / 1000000.0f;
        dt = clampf(dt, 0.0005f, 0.02f);
    }
    lastMicrosLocal = nowMicros;

    // Bias adaptativo: só aprende quando giroscópio E acelerômetro indicam repouso
    float gyroMag = fabsf(raw_gx_dps) + fabsf(raw_gy_dps) + fabsf(raw_gz_dps);
    float accelNormG = sqrtf(raw_ax_g * raw_ax_g + raw_ay_g * raw_ay_g + raw_az_g * raw_az_g);
    bool accelStill = fabsf(accelNormG - 1.0f) < ACCEL_REST_TOLERANCE_G;

    if (gyroMag < GYRO_REST_THRESHOLD_DPS && accelStill) {
        restCounter++;
        float alpha = GYRO_BIAS_LEARN_RATE;
        gyroBiasX = (1.0f - alpha) * gyroBiasX + alpha * measured_gx;
        gyroBiasY = (1.0f - alpha) * gyroBiasY + alpha * measured_gy;
        gyroBiasZ = (1.0f - alpha) * gyroBiasZ + alpha * measured_gz;

        if (restCounter >= GYRO_REST_SUSTAINED_COUNT) {
            gyroBiasX = (1.0f - GYRO_BIAS_STRONG_ALPHA) * gyroBiasX + GYRO_BIAS_STRONG_ALPHA * measured_gx;
            gyroBiasY = (1.0f - GYRO_BIAS_STRONG_ALPHA) * gyroBiasY + GYRO_BIAS_STRONG_ALPHA * measured_gy;
            gyroBiasZ = (1.0f - GYRO_BIAS_STRONG_ALPHA) * gyroBiasZ + GYRO_BIAS_STRONG_ALPHA * measured_gz;
            if (restCounter > GYRO_REST_SUSTAINED_COUNT + 200) restCounter = GYRO_REST_SUSTAINED_COUNT;
        }
    } else {
        restCounter = 0;
    }

    mahony.update(gx, gy, gz, ax_ms2, ay_ms2, az_ms2, dt);

    float qw, qx, qy, qz;
    mahony.getQuaternion(&qw, &qx, &qy, &qz);

#if DEBUG_SERIAL
    static uint32_t dbgCount = 0;
    if ((++dbgCount % DEBUG_PRINT_EVERY_N) == 0) {
        Serial.printf("QUAT w:%.4f x:%.4f y:%.4f z:%.4f\n", qw, qx, qy, qz);

        float t0 = +2.0f * (qw * qx + qy * qz);
        float t1 = +1.0f - 2.0f * (qx * qx + qy * qy);
        float roll = atan2f(t0, t1);

        float t2 = +2.0f * (qw * qy - qz * qx);
        t2 = clampf(t2, -1.0f, 1.0f);
        float pitch = asinf(t2);

        float t3 = +2.0f * (qw * qz + qx * qy);
        float t4 = +1.0f - 2.0f * (qy * qy + qz * qz);
        float yaw = atan2f(t3, t4);

        Serial.printf("YPR deg -> Yaw:%.2f Pitch:%.2f Roll:%.2f\n",
                      yaw * RAD_TO_DEG, pitch * RAD_TO_DEG, roll * RAD_TO_DEG);
    }
#endif

    // Envia quaternion (X, Y, Z, W)
    if (slimeConnected) {
        sendRotationQuatToServer(SERVER_IP, qx, qy, qz, qw);
    }
}

// ------------- Endpoint HTTP de reset -------------
void handleHttpReset() {
    Serial.println("[HTTP] Reset requested via HTTP endpoint.");
    mahony.resetOrientation();
    quickRecalibrateGyroBias();
    if (slimeConnected) {
        sendSensorInfo(SERVER_IP);
    }
    webServer.send(200, "text/plain", "OK");
}

// ------------- Setup / Loop -------------
void setup() {
    Serial.begin(115200);
    delay(50);
    Serial.println("=== SlimeVR tracker: ESP32 + LSM6DS3 (V3 corrigido) ===");

    serverIpFixed = !isZeroIp(SERVER_IP);

    connectWiFi();
    initIMU();

    delay(800);
    calibrateIMU();
    delay(1000);

    analogReadResolution(12);
    pinMode(VIN_ADC_PIN, INPUT);

    uint16_t localPort = 9185 + (uint16_t)TRACKER_ID;
    udp.begin(localPort);
    Serial.print("UDP started on port "); Serial.println(localPort);

    webServer.on("/reset", handleHttpReset);
    webServer.begin();
    Serial.println("HTTP server started (for /reset).");

    if (!serverIpFixed) {
        Serial.println("Discovering SlimeVR server via broadcast...");
        for (int i = 0; i < 6 && !slimeConnected; i++) {
            sendHandshake(SERVER_IP);
            if (waitForHandshakeResponse(1000)) break;
            delay(200);
        }
        if (!slimeConnected) {
            Serial.println("Server not found yet. Will keep trying in background...");
        } else {
            sendSensorInfo(SERVER_IP);
        }
    } else {
        sendHandshake(SERVER_IP);
        if (!waitForHandshakeResponse(800)) {
            slimeConnected = true;   // IP fixo: assume conectado e continua tentando o handshake
        }
        lastServerPacketMillis = millis();
        sendSensorInfo(SERVER_IP);
    }

    lastServerPacketMillis = millis();
    lastImuMicros = micros();
}

void loop() {
    unsigned long now = millis();

    // 1) Rede primeiro: ping/handshake/reset vindos do servidor
    handleIncomingUdp();

    // 2) Leitura do IMU a 100 Hz, sem acumular erro de tempo
    uint32_t nowUs = micros();
    if ((uint32_t)(nowUs - lastImuMicros) >= IMU_UPDATE_PERIOD_US) {
        lastImuMicros += IMU_UPDATE_PERIOD_US;
        if ((uint32_t)(nowUs - lastImuMicros) >= IMU_UPDATE_PERIOD_US) lastImuMicros = nowUs; // atrasou: não "recupera" em rajada
        readAndSendSensorData();
    }

    // 3) Heartbeat
    if (now - lastHeartbeatMillis >= 1000) {
        lastHeartbeatMillis = now;
        if (slimeConnected) sendHeartbeatToServer(SERVER_IP);
    }

    // 4) Mantém/recupera a ligação com o servidor
    checkServerLink();

    // 5) Watchdog de Wi-Fi
    if (now - lastWifiCheckMillis >= 5000) {
        lastWifiCheckMillis = now;
        if (WiFi.status() != WL_CONNECTED) {
            Serial.println("WiFi lost. Reconnecting...");
            WiFi.reconnect();
        }
    }

    // Reset manual pela serial
    if (Serial.available()) {
        char c = Serial.read();
        if (c == 'r' || c == 'R') {
            Serial.println("Reset orientation requested (Serial). Performing reset...");
            mahony.resetOrientation();
            quickRecalibrateGyroBias();
            if (slimeConnected) sendSensorInfo(SERVER_IP);
        }
    }

    // Requisições HTTP (/reset)
    webServer.handleClient();

#if DEBUG_SERIAL
    static unsigned long lastVinLog = 0;
    if (millis() - lastVinLog > 5000) {
        lastVinLog = millis();
        float vin = readVin();
        Serial.print("VIN ~ "); Serial.print(vin, 2); Serial.println(" V");
    }
#endif
}
