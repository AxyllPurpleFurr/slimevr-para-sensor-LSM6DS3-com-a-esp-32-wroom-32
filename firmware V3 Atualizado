const float GYRO_REST_THRESHOLD_DPS = 1.5f;    // soma |gx|+|gy|+|gz| (já sem bias) abaixo disso = repouso
const float ACCEL_REST_TOLERANCE_G  = 0.05f;   // módulo do accel deve estar em 1 g +- 5% para ser repouso
const float GYRO_BIAS_LEARN_RATE = 0.00025f;   // adaptação lenta e contínua (só em repouso)
const float GYRO_BIAS_STRONG_ALPHA = 0.004f;   // correção mais forte após repouso sustentado
const int   GYRO_REST_SUSTAINED_COUNT = 120;   // ciclos de repouso antes da correção forte

// Mahony gains
const float MAHONY_KP = 0.13f;
const float MAHONY_KI = 0.0f;

// [FIX 5] Calibração validada: só aceita o bias se o sensor estiver parado (desvio padrão baixo)
