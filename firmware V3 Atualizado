// --------------- Mahony AHRS ---------------
class MahonyAHRS {
public:
  MahonyAHRS(float kp = MAHONY_KP, float ki = MAHONY_KI) : twoKp(2.0f*kp), twoKi(2.0f*ki),
    q0(1.0f), q1(0.0f), q2(0.0f), q3(0.0f), integralFBx(0), integralFBy(0), integralFBz(0) {}

  void update(float gx, float gy, float gz, float ax, float ay, float az, float dt) {
    // gx,gy,gz in rad/s ; ax,ay,az in m/s^2
    float recipNorm;
    float vx, vy, vz;
    float ex, ey, ez;
    float qa, qb, qc;

    recipNorm = invSqrt(ax*ax + ay*ay + az*az);
    if (recipNorm <= 0.0f) return;
    ax *= recipNorm; ay *= recipNorm; az *= recipNorm;

    vx = 2.0f * (q1*q3 - q0*q2);
    vy = 2.0f * (q0*q1 + q2*q3);
    vz = q0*q0 - q1*q1 - q2*q2 + q3*q3;

    ex = (ay * vz - az * vy);
    ey = (az * vx - ax * vz);
    ez = (ax * vy - ay * vx);

    if (twoKi > 0.0f) {
      integralFBx += twoKi * ex * dt;
      integralFBy += twoKi * ey * dt;
      integralFBz += twoKi * ez * dt;
      gx += integralFBx; gy += integralFBy; gz += integralFBz;
    } else {
      integralFBx = integralFBy = integralFBz = 0.0f;
    }

    gx += twoKp * ex;
    gy += twoKp * ey;
    gz += twoKp * ez;

    gx *= 0.5f * dt;
    gy *= 0.5f * dt;
    gz *= 0.5f * dt;

    qa = q0; qb = q1; qc = q2;
    q0 += (-qb * gx - qc * gy - q3 * gz);
    q1 += (qa * gx + qc * gz - q3 * gy);
    q2 += (qa * gy - qb * gz + q3 * gx);
    q3 += (qa * gz + qb * gy - qc * gx);

    recipNorm = invSqrt(q0*q0 + q1*q1 + q2*q2 + q3*q3);
    q0 *= recipNorm; q1 *= recipNorm; q2 *= recipNorm; q3 *= recipNorm;
  }

  void getQuaternion(float *out_q0, float *out_q1, float *out_q2, float *out_q3) {
    *out_q0 = q0; *out_q1 = q1; *out_q2 = q2; *out_q3 = q3;
  }

  void resetOrientation() {
    q0 = 1.0f; q1 = q2 = q3 = 0.0f;
    integralFBx = integralFBy = integralFBz = 0.0f;
  }

private:
  float twoKp, twoKi;
  float q0,q1,q2,q3;
  float integralFBx, integralFBy, integralFBz;
  inline float invSqrt(float x) { if (x <= 0.0f) return 0.0f; return 1.0f / sqrtf(x); }
};

MahonyAHRS mahony(MAHONY_KP, MAHONY_KI);

// ------------- Protocol helpers -------------
void writeUint32BE(uint8_t *buf, uint32_t val){ buf[0]=(val>>24)&0xFF; buf[1]=(val>>16)&0xFF; buf[2]=(val>>8)&0xFF; buf[3]=(val)&0xFF; }
void writeUint64BE(uint8_t *buf, uint64_t val){ for(int i=0;i<8;i++) buf[i] = (val >> (56 - i*8)) & 0xFF; }
void writeFloatBE(uint8_t *buf, float v){ uint8_t tmp[4]; memcpy(tmp,&v,4); buf[0]=tmp[3]; buf[1]=tmp[2]; buf[2]=tmp[1]; buf[3]=tmp[0]; }

const uint8_t PACKET_HEARTBEAT = 0;
const uint8_t PACKET_HANDSHAKE = 3;
const uint8_t PACKET_SENSOR_INFO = 15;
const uint8_t PACKET_ROTATION_DATA = 17;

#define MAX_PKT 512
uint8_t pktbuf[MAX_PKT];
int pktpos = 0;
void pktBegin(){ pktpos = 0; }
void pktWriteByte(uint8_t b){ if(pktpos < MAX_PKT) pktbuf[pktpos++] = b; }
void pktWriteInt(uint32_t i){ writeUint32BE(pktbuf + pktpos, i); pktpos += 4; }
void pktWriteLong(uint64_t l){ writeUint64BE(pktbuf + pktpos, l); pktpos += 8; }
void pktWriteFloat(float f){ writeFloatBE(pktbuf + pktpos, f); pktpos += 4; }
void pktWriteBytes(const uint8_t *b, size_t n){ if(pktpos + (int)n < MAX_PKT){ memcpy(pktbuf + pktpos, b, n); pktpos += n; } }
void pktEndAndSend(IPAddress serverIp) { if (serverIp[0]==0 && serverIp[1]==0 && serverIp[2]==0 && serverIp[3]==0) udp.beginPacket(IPAddress(255,255,255,255), SLIME_PORT); else udp.beginPacket(serverIp, SLIME_PORT); udp.write(pktbuf, pktpos); udp.endPacket(); }

void sendHandshake(IPAddress serverIp) {
  pktBegin();
  pktWriteByte(0); pktWriteByte(0); pktWriteByte(0); pktWriteByte(PACKET_HANDSHAKE);
  pktWriteLong((uint64_t)0);
  pktWriteInt((uint32_t)2);
  pktWriteInt((uint32_t)12);
  pktWriteInt((uint32_t)3);
  pktWriteInt(0); pktWriteInt(0); pktWriteInt(0);
  pktWriteInt(1);
  const char *fw = "esp32-lsm6ds3-perfect-0.1";
  uint8_t flen = (uint8_t)strlen(fw);
  pktWriteByte(flen);
  pktWriteBytes((const uint8_t*)fw, flen);

  uint8_t mac[6];
  WiFi.macAddress(mac);
  mac[5] = TRACKER_ID;
  pktWriteBytes(mac, 6);

  pktEndAndSend(serverIp);
  Serial.println("Handshake sent.");
}

bool waitForHandshakeResponse(uint32_t timeout_ms = 5000) {
  uint32_t start = millis();
  while (millis() - start < timeout_ms) {
    int p = udp.parsePacket();
    if (p > 0) {
      int len = udp.read(pktbuf, sizeof(pktbuf));
      if (len > 0) {
        uint8_t type = pktbuf[0];
        if (type == PACKET_HANDSHAKE) {
          const char pattern[] = "Hey OVR =D 5";
          if (len >= 1 + (int)strlen(pattern) && memcmp(pktbuf + 1, pattern, strlen(pattern)) == 0) {
            IPAddress remote = udp.remoteIP();
            SERVER_IP = remote;
            slimeConnected = true;
            Serial.print("SlimeVR server found at: "); Serial.println(SERVER_IP);
            return true;
          }
        }
      }
    }
    delay(10);
  }
  return false;
}

void sendSensorInfo(IPAddress serverIp) {
  pktBegin();
  pktWriteByte(0); pktWriteByte(0); pktWriteByte(0); pktWriteByte(PACKET_SENSOR_INFO);
  pktWriteLong(packetNumber++);
  pktWriteByte(0);
  pktWriteByte(1);
  pktWriteByte(0);
  pktEndAndSend(serverIp);
  Serial.println("Sensor info (sensor 0) sent.");
}

void sendHeartbeatToServer(IPAddress serverIp) {
  if (!slimeConnected) return;
  pktBegin();
  pktWriteByte(0); pktWriteByte(0); pktWriteByte(0); pktWriteByte(PACKET_HEARTBEAT);
  pktWriteLong(packetNumber++);
  pktEndAndSend(serverIp);
}

void sendRotationQuatToServer(IPAddress serverIp, float x, float y, float z, float w) {
  if (!slimeConnected) return;
  pktBegin();
  pktWriteByte(0); pktWriteByte(0); pktWriteByte(0); pktWriteByte(PACKET_ROTATION_DATA);
  pktWriteLong(packetNumber++);
  pktWriteByte(0);
  pktWriteByte(1);
  pktWriteFloat(x); pktWriteFloat(y); pktWriteFloat(z); pktWriteFloat(w);
  pktWriteByte(0);
  pktEndAndSend(serverIp);
}

// ------------- IMU init / calibration -------------
void initIMU() {
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setClock(400000);   // [FIX 4] I2C rápido (400 kHz) para leituras mais curtas e regulares
  Serial.println("Initializing LSM6DS3...");

  // [FIX 4] Configuração do IMU ANTES do begin(): faixas menores = mais resolução e menos ruído
  imu.settings.gyroEnabled = 1;
  imu.settings.gyroRange = 1000;        // dps (padrão da lib era 2000)
  imu.settings.gyroSampleRate = 208;    // Hz
  imu.settings.gyroBandWidth = 100;
  imu.settings.accelEnabled = 1;
  imu.settings.accelRange = 4;          // g (padrão da lib era 16)
  imu.settings.accelSampleRate = 208;   // Hz
  imu.settings.accelBandWidth = 100;

  if (imu.begin() != 0) {
    Serial.println("ERROR: Could not initialize LSM6DS3.");
    while (1) delay(200);
  }
  Serial.println("LSM6DS3 OK.");
}

// [FIX 5] Mede o bias do giroscópio e informa se o sensor estava realmente parado.
// Retorna true se o desvio padrão de todos os eixos ficou abaixo de maxStdDps.
bool measureGyroBias(int samples, int delayMs, float maxStdDps, float &bx, float &by, float &bz) {
  double sx = 0, sy = 0, sz = 0;
  double sxx = 0, syy = 0, szz = 0;

  for (int i = 0; i < samples; i++) {
    double x = imu.readFloatGyroX();
    double y = imu.readFloatGyroY();
    double z = imu.readFloatGyroZ();
    sx += x; sy += y; sz += z;
    sxx += x * x; syy += y * y; szz += z * z;
    delay(delayMs);
  }

  double n = (double)samples;
  double mx = sx / n, my = sy / n, mz = sz / n;
  double vx = sxx / n - mx * mx;
  double vy = syy / n - my * my;
  double vz = szz / n - mz * mz;
  if (vx < 0) vx = 0;
  if (vy < 0) vy = 0;
  if (vz < 0) vz = 0;

  float stdX = sqrtf((float)vx), stdY = sqrtf((float)vy), stdZ = sqrtf((float)vz);
  float stdMax = stdX;
  if (stdY > stdMax) stdMax = stdY;
  if (stdZ > stdMax) stdMax = stdZ;

  bx = (float)mx; by = (float)my; bz = (float)mz;

  Serial.printf("  bias medido -> X: %.4f Y: %.4f Z: %.4f | std max: %.4f dps\n", bx, by, bz, stdMax);
  return stdMax <= maxStdDps;
}

void calibrateIMU() {
  Serial.println("Gyro calibration: keep the tracker STILL...");
  delay(3000);

  float bx = 0, by = 0, bz = 0;
  bool ok = false;

  for (int attempt = 1; attempt <= BOOT_CAL_MAX_ATTEMPTS; attempt++) {
    Serial.printf("Calibration attempt %d/%d\n", attempt, BOOT_CAL_MAX_ATTEMPTS);
    ok = measureGyroBias(BOOT_CAL_SAMPLES, BOOT_CAL_DELAY_MS, CAL_MAX_STD_DPS, bx, by, bz);
    if (ok) break;
    Serial.println("  Sensor se moveu durante a calibracao, tentando de novo...");
    delay(500);
  }

  // Mesmo que nunca fique parado, usa a última medição (o bias adaptativo corrige depois)
  gyroBiasX = bx; gyroBiasY = by; gyroBiasZ = bz;
  restCounter = 0;

  if (ok) Serial.println("Gyro calibration done (valid).");
  else    Serial.println("WARNING: calibration finished without a still sensor. Press 'r' or reset when still.");
  Serial.printf("Bias -> X: %.6f  Y: %.6f  Z: %.6f\n", gyroBiasX, gyroBiasY, gyroBiasZ);

  // zera offsets de acelerômetro para não interferir
  imuOffsets.ax = 0;
  imuOffsets.ay = 0;
  imuOffsets.az = 0;
}

// [FIX 5] Recalibração no reset: só troca o bias se o sensor estiver parado.
// Se você estiver se mexendo no reset, mantém o bias anterior (evita drift).
void quickRecalibrateGyroBias(int samples = QUICK_RECAL_SAMPLES) {
  Serial.println("Quick recalibrate gyro bias (reset)...");
  float bx, by, bz;
  bool still = measureGyroBias(samples, BOOT_CAL_DELAY_MS, CAL_MAX_STD_DPS, bx, by, bz);
  if (still) {
    gyroBiasX = bx; gyroBiasY = by; gyroBiasZ = bz;
    restCounter = 0;
    Serial.printf("New bias: %.6f %.6f %.6f\n", gyroBiasX, gyroBiasY, gyroBiasZ);
  } else {
    Serial.println("Sensor em movimento: bias anterior mantido.");
  }
}

// ------------- WiFi -------------
void connectWiFi() {
  Serial.println("Starting WiFiManager...");
  WiFiManager wm;
  const char* ap_name = "SlimeVR Tracker Setup";
  if (!wm.autoConnect(ap_name)) {
    Serial.println("WiFiManager failed - restarting...");
    delay(2000);
    ESP.restart();
  }

  // [FIX 2] Desliga o modem sleep: elimina picos de latência que viram "engasgos" no tracker
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);

  Serial.print("Connected. IP: ");
  Serial.println(WiFi.localIP());
}

// ------------- Helpers -------------
#ifndef DEG_TO_RAD
#define DEG_TO_RAD 0.01745329251994329576923690768489f
#endif
#ifndef RAD_TO_DEG
#define RAD_TO_DEG 57.295779513082320876f
#endif
const float G_TO_MS2 = 9.80665f;

static inline float clampf(float v, float a, float b) {
  if (v < a) return a;
  if (v > b) return b;
  return v;
}

float readVin() {
  int raw = analogRead(VIN_ADC_PIN);
  float v = ((float)raw / 4095.0f) * ADC_REF;
  return v * VIN_SCALE;
}

