// If using direct measurement through divider R1=100k, R2=47k: VIN_SCALE = (R1+R2)/R2
const float VIN_SCALE = (100000.0f + 47000.0f) / 47000.0f;
const float ADC_REF = 3.3f; // ADC reference

// Misc
