#include <WiFi.h>
#include <WiFiUdp.h>
#include <Wire.h>
#include "SparkFunLSM6DS3.h" // Biblioteca para o sensor IMU LSM6DS3
#include <MadgwickAHRS.h>   // Biblioteca para o filtro de fusão de sensores

// --- CONFIGURAÇÕES DO USUÁRIO ---
#define WIFI_SSID "VR 2.4G"
#define WIFI_PASSWORD "ARBa8486"

// IP do computador onde o servidor SlimeVR está rodando
#define SERVER_IP IPAddress(192,168,2,37)
#define SERVER_PORT 6969

// Pinos I2C para o sensor no seu ESP32
#define I2C_SDA 21
#define I2C_SCL 22

// Frequência de atualização do sensor (em Hz)
#define IMU_UPDATE_RATE 100
const unsigned long IMU_UPDATE_PERIOD_MS = 1000 / IMU_UPDATE_RATE;

// --- OBJETOS GLOBAIS ---
LSM6DS3 imu(I2C_MODE, 0x6B); // Cria o objeto do sensor IMU
Madgwick filter;             // Cria o objeto do filtro Madgwick
WiFiUDP udp;                 // Cria o objeto para comunicação UDP

// Variáveis para controle de tempo
unsigned long lastImuUpdateTime = 0;
unsigned long lastHeartbeatTime = 0;

// Contador de pacotes (exigido pelo protocolo SlimeVR)
uint64_t packetNumber = 0;

// --- SEÇÃO DE CALIBRAÇÃO ---
// Estrutura para armazenar os desvios (offsets) do sensor
struct IMUOffsets {
    float ax, ay, az;
    float gx, gy, gz;
};
IMUOffsets imuOffsets = {0, 0, 0, 0, 0, 0};

// --- FUNÇÃO DE SETUP ---
// Executada uma vez quando o ESP32 é ligado ou resetado
void setup() {
    // Inicia a comunicação serial para debug
    Serial.begin(115200);
    while (!Serial); // Espera a porta serial conectar
    Serial.println("\n### Iniciando Tracker SlimeVR ###");

    // Inicia a conexão Wi-Fi
    connectWiFi();

    // Inicia o sensor IMU
    initIMU();

    // **NOVO: Executa a rotina de calibração do sensor**
    calibrateIMU();

    // Inicia o filtro Madgwick com a taxa de atualização definida
    filter.begin(IMU_UPDATE_RATE);

    // Inicia o UDP
    udp.begin(SERVER_PORT);
    Serial.println("Comunicação UDP iniciada.");

    // Envia o pacote de handshake para o servidor SlimeVR
    sendHandshake();
}

// --- FUNÇÃO DE LOOP ---
// Executada repetidamente
void loop() {
    // Controla o tempo para manter a taxa de atualização constante
    if (millis() - lastImuUpdateTime >= IMU_UPDATE_PERIOD_MS) {
        lastImuUpdateTime = millis();

        // Lê os dados do sensor e envia para o servidor
        readAndSendSensorData();
    }

    // Envia um pacote de heartbeat a cada 1 segundo para manter a conexão
    if (millis() - lastHeartbeatTime >= 1000) {
        lastHeartbeatTime = millis();
        sendHeartbeat();
    }
}

// --- FUNÇÕES AUXILIARES ---

/**
 * @brief Conecta-se à rede Wi-Fi definida.
 */
void connectWiFi() {
    Serial.print("Conectando ao Wi-Fi: ");
    Serial.print(WIFI_SSID);

    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }
    Serial.println("\nConectado com sucesso!");
    Serial.print("Endereço IP: ");
    Serial.println(WiFi.localIP());
}

/**
 * @brief Inicializa o sensor IMU LSM6DS3.
 */
void initIMU() {
    Wire.begin(I2C_SDA, I2C_SCL);
    Serial.println("Iniciando sensor IMU (LSM6DS3)...");

    if (imu.begin() != 0) {
        Serial.println("ERRO: Falha ao inicializar o LSM6DS3. Verifique as conexões.");
        while (1); // Trava a execução
    }
    Serial.println("Sensor IMU iniciado com sucesso.");
}

/**
 * @brief **NOVO!** Rotina de calibração do IMU.
 * Deve ser executada com o sensor parado em uma superfície plana.
 */
void calibrateIMU() {
    Serial.println("\n--- INICIANDO CALIBRAÇÃO DO SENSOR ---");
    Serial.println("Mantenha o tracker PARADO e em superfície PLANA por 5 segundos...");
    delay(5000); // Dá tempo ao usuário para deixar o tracker estável

    const int numSamples = 1000;
    float sumAx = 0, sumAy = 0, sumAz = 0;
    float sumGx = 0, sumGy = 0, sumGz = 0;

    Serial.println("Calibrando... Por favor, aguarde.");

    for (int i = 0; i < numSamples; i++) {
        sumAx += imu.readFloatAccelX();
        sumAy += imu.readFloatAccelY();
        sumAz += imu.readFloatAccelZ();
        sumGx += imu.readFloatGyroX();
        sumGy += imu.readFloatGyroY();
        sumGz += imu.readFloatGyroZ();
        delay(2); // Pequeno delay entre as leituras
    }

    // Calcula a média dos desvios
    imuOffsets.ax = sumAx / numSamples;
    imuOffsets.ay = sumAy / numSamples;
    // O eixo Z do acelerômetro aponta para a gravidade (1G), então subtraímos isso.
    // Se o seu tracker estiver de cabeça para baixo, mude para (sumAz / numSamples) + 1.0f
    imuOffsets.az = (sumAz / numSamples) - 1.0f; 
    imuOffsets.gx = sumGx / numSamples;
    imuOffsets.gy = sumGy / numSamples;
    imuOffsets.gz = sumGz / numSamples;

    Serial.println("\n--- Calibração Concluída! ---");
    Serial.println("Offsets calculados:");
    Serial.printf("Acc (X,Y,Z): %.4f, %.4f, %.4f\n", imuOffsets.ax, imuOffsets.ay, imuOffsets.az);
    Serial.printf("Gyro(X,Y,Z): %.4f, %.4f, %.4f\n\n", imuOffsets.gx, imuOffsets.gy, imuOffsets.gz);
}

/**
 * @brief Lê os dados do acelerômetro e giroscópio, aplica a calibração,
 * atualiza o filtro e envia os dados de rotação para o servidor.
 */
void readAndSendSensorData() {
    // Lê os dados brutos do sensor
    float ax_raw = imu.readFloatAccelX();
    float ay_raw = imu.readFloatAccelY();
    float az_raw = imu.readFloatAccelZ();
    float gx_raw = imu.readFloatGyroX();
    float gy_raw = imu.readFloatGyroY();
    float gz_raw = imu.readFloatGyroZ();

    // **MODIFICADO: Aplica os offsets da calibração**
    float ax = ax_raw - imuOffsets.ax;
    float ay = ay_raw - imuOffsets.ay;
    float az = az_raw - imuOffsets.az;
    float gx = gx_raw - imuOffsets.gx;
    float gy = gy_raw - imuOffsets.gy;
    float gz = gz_raw - imuOffsets.gz;

    // Atualiza o filtro com os dados corrigidos para calcular a orientação
    filter.update(gx, gy, gz, ax, ay, az);

    // Obtém o quaternion resultante do filtro
    float qw, qx, qy, qz;
    filter.getQuaternion(&qw, &qx, &qy, &qz);

    // Monta o pacote de rotação conforme o protocolo SlimeVR
    uint8_t rotationPacket[29];
    uint32_t packetType = 3; // Tipo 3: Rotação
    uint8_t sensorId = 0;    // ID do sensor (0 para o primeiro/principal)

    // Cabeçalho do pacote
    memcpy(rotationPacket, &packetType, 4);
    memcpy(rotationPacket + 4, &packetNumber, 8);

    // Carga útil (Payload)
    // A ordem do quaternion para o SlimeVR é: X, Y, Z, W
    memcpy(rotationPacket + 12, &sensorId, 1);
    memcpy(rotationPacket + 13, &qx, 4);
    memcpy(rotationPacket + 17, &qy, 4);
    memcpy(rotationPacket + 21, &qz, 4);
    memcpy(rotationPacket + 25, &qw, 4);

    // Envia o pacote
    udp.beginPacket(SERVER_IP, SERVER_PORT);
    udp.write(rotationPacket, sizeof(rotationPacket));
    udp.endPacket();

    packetNumber++; // Incrementa o número do pacote para o próximo envio
}

/**
 * @brief Envia o pacote de Handshake para se registrar no servidor.
 */
void sendHandshake() {
    uint8_t handshakePacket[64] = {0}; // Buffer zerado
    uint32_t packetType = 0; // Tipo 0: Handshake

    memcpy(handshakePacket, &packetType, 4);
    memcpy(handshakePacket + 4, &packetNumber, 8);

    uint32_t board = 0; // BOARD_CUSTOM
    uint32_t imuType = 12; // IMU_LSM6DS3
    uint32_t mcuType = 3;  // MCU_ESP32
    
    memcpy(handshakePacket + 12, &board, 4);
    memcpy(handshakePacket + 16, &imuType, 4);
    memcpy(handshakePacket + 20, &mcuType, 4);

    const char* fw_version = "0.1.0-cal"; // Versão atualizada
    strcpy((char*)handshakePacket + 36, fw_version);

    udp.beginPacket(SERVER_IP, SERVER_PORT);
    udp.write(handshakePacket, sizeof(handshakePacket));
    udp.endPacket();

    Serial.println("Pacote de Handshake enviado.");
    packetNumber++;
}

/**
 * @brief Envia um pacote de Heartbeat para manter o tracker "vivo" no servidor.
 */
void sendHeartbeat() {
    uint8_t heartbeatPacket[12];
    uint32_t packetType = 2; // Tipo 2: Heartbeat

    memcpy(heartbeatPacket, &packetType, 4);
    memcpy(heartbeatPacket + 4, &packetNumber, 8);

    udp.beginPacket(SERVER_IP, SERVER_PORT);
    udp.write(heartbeatPacket, sizeof(heartbeatPacket));
    udp.endPacket();

    packetNumber++;
}
